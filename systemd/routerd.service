[Unit]
Description=routerd - eBPF Stealth Router, DNS Resolver and Hotspot Daemon
Documentation=https://github.com/muadzhdz/routerd
After=network.target network-online.target systemd-resolved.service
Wants=network-online.target

[Service]
Type=simple
# Binary location after installation via 'sudo cp routerd /usr/local/bin/'
# Settings are loaded from /etc/routerd/routerd.conf (HOTSPOT, SSID, PASSWORD, etc.)
ExecStart=/usr/local/bin/routerd --headless
Restart=on-failure
RestartSec=5s
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=15s

# Linux Least-Privilege Capabilities
CapabilityBoundingSet=CAP_NET_ADMIN CAP_BPF CAP_NET_RAW CAP_SYS_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_BPF CAP_NET_RAW CAP_SYS_ADMIN CAP_NET_BIND_SERVICE
LimitMEMLOCK=infinity

# Systemd Runtime Directory (/run/routerd)
RuntimeDirectory=routerd
RuntimeDirectoryMode=0755

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
