# WireGuard VPN Configuration Profile Template for routerd
# Copy this file to /etc/routerd/vpn.conf and fill in your keys.

[Interface]
# PrivateKey = YOUR_PRIVATE_KEY
# Address = 172.16.0.2/32
# DNS = 1.1.1.1, 1.0.0.1

[Peer]
# PublicKey = SERVER_PUBLIC_KEY
# Endpoint = SERVER_IP:51820
# AllowedIPs = 0.0.0.0/0, ::/0
