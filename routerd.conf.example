# routerd configuration
# Copy this file to /etc/routerd.conf and adjust as needed.

# Network name shown to nearby devices.
SSID=routerd

# Wi-Fi password (WPA2-PSK). Minimum 8 characters.
# Empty = open network without password.
PASSWORD=

# Channel for the access point.
#   auto = follow the channel of your current Wi-Fi connection (recommended)
#   1-11 (2.4 GHz) or 36-165 (5 GHz) = fixed channel
CHANNEL=auto

# Wireless client interface used as the internet uplink.
#   auto = detect automatically (recommended)
INTERFACE_STA=auto

# Name of the virtual access point interface.
INTERFACE_AP=ap0

# Interface used for NAT (internet sharing).
#   auto = the interface holding the default route
#   wg0 / tun0 = route all client traffic through WireGuard/VPN interface
UPLINK=auto

# Subnet for connected clients.
#   192.168.50.0/24 = fixed subnet
#   random = generate a random RFC1918 subnet every time routerd starts
SUBNET=random

# ISO 3166-1 country code for legal radio usage.
COUNTRY=ID

# Maximum number of connected clients.
MAX_CLIENTS=16

# DNS server advertised to clients (systemd-resolved stub by default).
DNS=127.0.0.53

# --- Stealth & Anonymity Settings ---

# Generate a 100% random MAC address for the AP interface on every start.
RANDOM_MAC=true

# Block connected AP clients from scanning or accessing local host services.
ISOLATE_HOST=true

# Set outgoing TTL to hide tethering / hop counts from ISP (64 recommended, 0 to disable).
SPOOF_TTL=64

# Transparently route all TCP and DNS traffic through Tor (requires local Tor service).
TOR_MODE=false

# Disable IPv6 on AP interface & block IPv6 forwarding to prevent leaks (recommended).
DISABLE_IPV6=true

# Hide SSID broadcast (hidden network mode).
HIDE_SSID=false

# Bandwidth rate limit on AP interface in Mbps (0 = unlimited).
LIMIT_RATE_MBPS=0

# --- Transparent VPN Gateway Settings ---

# Automatically route all connected AP client traffic through a VPN tunnel.
ENABLE_VPN=false

# VPN Mode:
#   wireguard = use a WireGuard configuration file (.conf)
#   warp      = use Cloudflare WARP WireGuard profile
#   custom    = use an existing active VPN interface (wg0, tun0, tailscale0)
#   dpibypass = bypass DPI censorship via TCP MSS & SNI fragmentation
VPN_MODE=wireguard

# Path to WireGuard profile (for wireguard or warp mode)
VPN_CONFIG=/etc/routerd/vpn.conf

# Interface name of the VPN (for custom mode or wg-quick interface)
VPN_INTERFACE=wg0

# VPN Kill-Switch: block client internet access if VPN connection drops
VPN_KILL_SWITCH=true



