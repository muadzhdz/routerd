# /etc/routerd/routerd.conf
# routerd configuration file

# Target WAN network interface (leave 'auto' for default route auto-detection)
WAN_IFACE=auto

# Enable Wi-Fi Hotspot & Stealth NAT Router (true / false)
HOTSPOT=true

# Wi-Fi Hotspot SSID
SSID=routerd

# Wi-Fi Hotspot WPA2 Passphrase (minimum 8 characters)
PASSWORD=kopi-hitam123

# Prevent Wi-Fi clients from communicating with or sniffing each other (true / false)
CLIENT_ISOLATION=true

# Upstream DNS servers for stealth DoH / DoT fallback (comma-separated IPs, https:// DoH, or tls:// DoT URIs)
# Supports: 1.1.1.1, 8.8.8.8, 9.9.9.9, tls://1.1.1.1:853, tls://9.9.9.9:853
UPSTREAMS=1.1.1.1, 8.8.8.8, 9.9.9.9, tls://1.1.1.1:853, tls://9.9.9.9:853

# In-Memory DNS Ad & Malware Blocker (true / false)
BLOCK_ADS=true

# Path to ad/malware domain blocklist file
BLOCKLIST_FILE=/etc/routerd/blocklist.txt

# Optional WireGuard VPN Uplink Integration (true / false)
VPN_ENABLED=false

# Path to WireGuard VPN client profile (.conf)
VPN_CONFIG=/etc/routerd/vpn.conf

